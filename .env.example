# OneSight Environment Configuration

# Application Settings
PROJECT_NAME="OneSight"
DATABASE_URL="sqlite:///./onesight.db"
MOCK_CLOUD_ENABLED=True

# Multi-Cloud Credentials (Optional - simulator provides realistic data if left empty)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="us-east-1"

GCP_PROJECT_ID=""
GCP_CREDENTIALS_FILE=""

AZURE_SUBSCRIPTION_ID=""
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Agentic AI Engine (Choose any free/open-source or proprietary provider)
# 1. Groq (Free fast inference with open-source Meta Llama 3.3 70B - get free key at https://console.groq.com/keys)
GROQ_API_KEY=""
LLM_MODEL="llama-3.3-70b-versatile"

# 2. Ollama (100% Local & Free Open-Source - no API key needed, run: ollama run llama3.1)
OLLAMA_BASE_URL=""

# 3. Google Gemini (Free tier at https://aistudio.google.com/)
GEMINI_API_KEY=""

# 4. OpenAI
OPENAI_API_KEY=""

# Multi-Channel Alert Notification Webhooks (Optional - can also configure via UI)
DEFAULT_SLACK_WEBHOOK=""
DEFAULT_DISCORD_WEBHOOK=""
DEFAULT_GENERIC_WEBHOOK=""
DEFAULT_ALERT_EMAIL="finops-alerts@company.internal"
