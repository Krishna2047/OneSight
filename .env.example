# OneSight Environment Configuration

# Application Settings
PROJECT_NAME="OneSight"
DATABASE_URL="sqlite:///./onesight.db"
MOCK_CLOUD_ENABLED=True

# Multi-Cloud Credentials (Optional - simulator provides realistic data if left empty)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_DEFAULT_REGION="us-east-1"

GCP_PROJECT_ID=""
GCP_CREDENTIALS_FILE=""

AZURE_SUBSCRIPTION_ID=""
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Agentic AI Engine (Optional - built-in FinOps expert heuristic engine active by default)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Multi-Channel Alert Notification Webhooks (Optional - can also configure via UI)
DEFAULT_SLACK_WEBHOOK=""
DEFAULT_DISCORD_WEBHOOK=""
DEFAULT_GENERIC_WEBHOOK=""
DEFAULT_ALERT_EMAIL="finops-alerts@company.internal"
